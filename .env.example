# Copia este fichero a .env y rellena tus datos.
# .env está en .gitignore: no se sube al repositorio.

MOOVI_URL=https://moovi.uvigo.gal
MOOVI_USER=tu_usuario
MOOVI_PASSWORD=tu_contrasena

# Alternativa si el login por contraseña no funciona (por ejemplo, si la cuenta
# solo admite SSO). Pega aquí el token de:
# https://moovi.uvigo.gal/user/managetoken.php
# MOOVI_TOKEN=
