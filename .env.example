# Copia este fichero a .env.
# .env está en .gitignore: no se sube al repositorio.

MOOVI_URL=https://moovi.uvigo.gal

# Opcional: evita que `moovi login` pregunte el usuario.
# MOOVI_USER=tu_usuario

# Recomendado: no guardes la contraseña. `moovi login` la pide por terminal
# y guarda solo el token.
# Solo para scripts o CI con `moovi login --no-input`:
# MOOVI_PASSWORD=tu_contrasena

# Alternativa si el login por contraseña no funciona (por ejemplo, SSO):
# https://moovi.uvigo.gal/user/managetoken.php
# MOOVI_TOKEN=
